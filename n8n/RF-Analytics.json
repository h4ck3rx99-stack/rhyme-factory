      "parameters": {
        "content": "## RF - Analytics\nEvery Monday: pulls views/likes/comments (YouTube Data API, 1 unit per 50 videos) and\nwatch time / retention / subs (YouTube Analytics API), writes them to Videos, and recomputes\nTopicWeights, which Plan Run uses to pick categories. Keep the category list identical to RF - Main.",
        "height": 190,
        "width": 640,
        "color": 7
      }
    },
