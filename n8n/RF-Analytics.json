    {
      "id": "4a2904e0-1349-4b18-ae31-9403f38ed642",
      "name": "Build Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        40
      ],
      "parameters": {
        "jsCode": "// BUILD BATCHES — YouTube IDs from the Videos sheet, 50 per videos.list call (1 quota unit each).\nconst cfg = $('Analytics Config').first().json.cfg;\nconst rows = $('Read Videos').all().map((i) => i.json).filter((r) => r.youtube_id && r.status !== 'failed');\nconst ids = [...new Set(rows.map((r) => String(r.youtube_id).trim()).filter((id) => /^[A-Za-z0-9_-]{11}$/.test(id)))];\nif (!ids.length) return []; // nothing published yet\nconst today = new Date().toISOString().slice(0, 10);\nconst out = [];\nfor (let i = 0; i < ids.length; i += 50) {\n  out.push({ json: { ids: ids.slice(i, i + 50).join(','), all_ids: ids.slice(-200).join(','), start_date: cfg.channel_start_date, end_date: today } });\n}\nreturn out;\n"
      }
    },
