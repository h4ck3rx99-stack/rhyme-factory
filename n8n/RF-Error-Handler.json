        -40,
        -240
      ],
      "parameters": {
        "content": "## RF - Error Handler\nSet this as the *Error workflow* of RF - Main (Workflow -> Settings).\nMarks the video row as failed (matched by execution id) and appends to the Errors tab.\nRuns only for production (scheduled/active) executions, not for manual test runs.",
        "height": 180,
        "width": 560,
        "color": 7
      }
    },
    {
      "id": "f1fcf463-7879-40ac-b6e7-cf496d509b0e",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "ae07cadf-e612-40d9-b879-d8511fc9c93e",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// FORMAT ERROR — turns the Error Trigger payload into one row for Google Sheets.\nconst e = $input.first().json;\nconst message = String(e.execution?.error?.message || e.trigger?.error?.message || 'unknown error');\nconst id = message.match(/NR-\\d{8}-[A-Z0-9]{4}/);\nreturn [{\n  json: {\n    at: new Date().toISOString(),\n    workflow: e.workflow?.name || '',\n    exec_id: String(e.execution?.id ?? ''),\n    video_id: id ? id[0] : '',\n    failed_node: e.execution?.lastNodeExecuted || '',\n    error: message.slice(0, 1000),\n    execution_url: e.execution?.url || '',\n  },\n}];\n"
      }
    },
